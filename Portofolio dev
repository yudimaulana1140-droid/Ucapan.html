        /* Ambient Glowing Backgrounds */
        .ambient-glow {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 800px;
            height: 800px;
            background: radial-gradient(circle, rgba(160, 10, 10, 0.25) 0%, rgba(11, 2, 3, 0) 70%);
            pointer-events: none;
            z-index: 0;
        }

        .avatar-glow {
            box-shadow: 0 0 45px 12px rgba(255, 215, 0, 0.65), inset 0 0 15px rgba(255, 215, 0, 0.5);
        }

        .red-btn-glow {
            box-shadow: 0 0 20px rgba(229, 9, 20, 0.4);
            transition: all 0.3s ease;
        }

        .red-btn-glow:hover {
            box-shadow: 0 0 35px rgba(255, 42, 42, 0.8);
            transform: translateY(-2px);
        }

        /* Orbit System Setup */
        .orbit-container {
            position: relative;
            width: 380px;
            height: 380px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .orbit-ring {
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            border: 1px stroke rgba(255, 255, 255, 0.05);
            animation: spin 35s linear infinite;
        }

        .orbit-ring-reverse {
            animation: spin-reverse 28s linear infinite;
        }

        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        @keyframes spin-reverse {
            from { transform: rotate(360deg); }
            to { transform: rotate(0deg); }
        }

        .tech-bubble {
            position: absolute;
            width: 46px;
            height: 46px;
            border-radius: 50%;
            background: #1c080a;
            border: 1px solid rgba(255, 255, 255, 0.15);
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            transition: transform 0.3s ease;
        }

        .tech-bubble:hover {
            scale: 1.25;
            border-color: #ff2a2a;
            box-shadow: 0 0 15px rgba(255, 42, 42, 0.6);
        }

        /* Typing Cursor Blink */
        .cursor {
            display: inline-block;
            width: 3px;
            background-color: #e50914;
            margin-left: 4px;
            animation: blink 0.7s infinite;
        }

        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0; }
        }

        /* Glassmorphism Card Style */
        .glass-card {
            background: rgba(22, 7, 8, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(229, 9, 20, 0.15);
            transition: all 0.3s ease;
        }

        .glass-card:hover {
            border-color: rgba(229, 9, 20, 0.4);
            transform: translateY(-4px);
        }
    </style>
